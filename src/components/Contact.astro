---
import { site, enquiryPackages, travellerOptions } from '../data/site';

interface Props { preselect?: string }
const { preselect } = Astro.props;
// A package page passes its own name; add it to the list if it isn't already there.
const options = preselect && !enquiryPackages.includes(preselect as any)
  ? [preselect, ...enquiryPackages]
  : enquiryPackages;
---

<section class="section section--dark contact" id="contact">
  <div class="wrap contact__grid">
    <div class="contact__intro">
      <p class="kicker" data-reveal>Let's plan your trip</p>
      <h2 data-reveal data-reveal-delay="80">Tell us about your <span class="italic contact__italic">dream Kerala holiday.</span></h2>
      <p data-reveal data-reveal-delay="140">
        Share a few details about your trip and our travel team can help you plan an unforgettable journey
        through Kerala.
      </p>

      <ul class="contact__list" data-reveal data-reveal-delay="180">
        <li>
          <span class="contact__icon" aria-hidden="true">☎</span>
          <span><small>Call Us</small><a href={`tel:${site.phoneHref}`}>{site.phone}</a></span>
        </li>
        <li>
          <span class="contact__icon" aria-hidden="true">✉</span>
          <span><small>Email Us</small><a href={`mailto:${site.email}`}>{site.email}</a></span>
        </li>
        <li>
          <span class="contact__icon" aria-hidden="true">⚲</span>
          <span><small>Based In</small><b>{site.location}</b></span>
        </li>
      </ul>
    </div>

    <div class="contact__formwrap" data-reveal data-reveal-delay="120">
      <form class="form" data-enquiry novalidate>
        <div class="form__row">
          <div class="field">
            <label for="name">Your Name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" required placeholder="e.g. Anjali Nair" />
            <p class="field__err" data-err-for="name"></p>
          </div>
          <div class="field">
            <label for="phone">Phone Number <span aria-hidden="true">*</span></label>
            <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="e.g. +91 98765 43210" />
            <p class="field__err" data-err-for="phone"></p>
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="email">Email <small>(optional)</small></label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
            <p class="field__err" data-err-for="email"></p>
          </div>
          <div class="field">
            <label for="date">Travel Date</label>
            <input id="date" name="date" type="date" />
            <p class="field__err" data-err-for="date"></p>
          </div>
        </div>

        <div class="form__row">
          <div class="field">
            <label for="travellers">Travellers</label>
            <select id="travellers" name="travellers">
              {travellerOptions.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="package">Preferred Package</label>
            <select id="package" name="package">
              {options.map((p) => <option value={p} selected={p === preselect}>{p}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="message">Tell us about your trip</label>
          <textarea id="message" name="message" rows="4" maxlength="600" placeholder="Places you'd like to see, budget, anything special…"></textarea>
          <p class="field__hint"><span data-char-count>0</span>/600</p>
        </div>

        <button type="submit" class="btn btn--gold btn--block form__submit">
          Send Enquiry <span class="arrow" aria-hidden="true">→</span>
        </button>
        <p class="form__note">
          Prefer to chat? We'll open WhatsApp with your enquiry ready to send.
        </p>
      </form>

      <div class="form__done" data-enquiry-done hidden>
        <div class="form__tick" aria-hidden="true">✓</div>
        <h3>Thank you!</h3>
        <p>Your enquiry is ready. Send it to our team and we'll get back to you shortly.</p>
        <a class="btn btn--gold btn--block" data-wa-send href="#" target="_blank" rel="noopener noreferrer">
          Send on WhatsApp
        </a>
        <a class="btn btn--light btn--block" data-mail-send href="#" style="margin-top:0.6rem;">Send by Email</a>
        <button type="button" class="link-arrow form__again" data-enquiry-reset>Edit my enquiry</button>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__grid { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact__italic { color: var(--gold-400); }
  .contact__intro h2 { margin-top: 0.85rem; }
  .contact__intro > p { margin-top: 1rem; color: rgba(250, 247, 240, 0.75); }

  .contact__list { display: grid; gap: 1rem; margin-top: 2rem; }
  .contact__list li { display: flex; align-items: center; gap: 0.9rem; }
  .contact__icon {
    width: 44px; height: 44px; flex: 0 0 auto; border-radius: 50%;
    display: grid; place-content: center;
    border: 1px solid rgba(255, 255, 255, 0.22); color: var(--gold-400);
  }
  .contact__list small {
    display: block; font-size: 0.68rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(250, 247, 240, 0.55);
  }
  .contact__list a, .contact__list b { font-size: 0.98rem; font-weight: 600; }
  .contact__list a:hover { color: var(--gold-400); }

  .contact__formwrap {
    background: var(--cream); color: var(--ink);
    border-radius: var(--radius-lg); padding: clamp(1.35rem, 4vw, 2.25rem);
    box-shadow: var(--shadow-lg);
  }
  .form { display: grid; gap: 1rem; }
  .form__row { display: grid; gap: 1rem; }
  .field { display: grid; gap: 0.4rem; }
  .field label { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.04em; }
  .field label span { color: var(--gold-600); }
  .field label small { font-weight: 400; color: var(--ink-soft); }
  .field input, .field select, .field textarea {
    width: 100%; padding: 0.85rem 1rem; min-height: 48px;
    border: 1px solid var(--line); border-radius: var(--radius-sm);
    background: var(--white); font-size: 0.95rem;
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .field textarea { resize: vertical; min-height: 110px; }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none; border-color: var(--green-600);
    box-shadow: 0 0 0 3px rgba(20, 107, 79, 0.14);
  }
  .field input.is-invalid, .field select.is-invalid, .field textarea.is-invalid {
    border-color: #c0392b; box-shadow: 0 0 0 3px rgba(192, 57, 43, 0.12);
  }
  .field__err { font-size: 0.76rem; color: #c0392b; min-height: 1em; }
  .field__err:empty { min-height: 0; }
  .field__hint { font-size: 0.74rem; color: var(--ink-soft); text-align: right; }
  .form__submit { margin-top: 0.5rem; }
  .form__note { font-size: 0.78rem; color: var(--ink-soft); text-align: center; }

  .form__done { text-align: center; padding-block: 1rem; }
  .form__tick {
    width: 62px; height: 62px; margin: 0 auto 1.1rem; border-radius: 50%;
    display: grid; place-content: center; font-size: 1.6rem;
    background: var(--green-700); color: var(--cream);
    animation: pop 0.4s var(--ease);
  }
  @keyframes pop { from { transform: scale(0.7); opacity: 0; } to { transform: none; opacity: 1; } }
  .form__done p { color: var(--ink-soft); margin-block: 0.6rem 1.35rem; font-size: 0.92rem; }
  .form__done .btn--light { background: var(--green-700); color: var(--cream); border-color: var(--green-700); }
  .form__again { margin-top: 1.25rem; }

  @media (min-width: 560px) { .form__row { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1000px) { .contact__grid { grid-template-columns: 0.9fr 1.1fr; } }
</style>

<script define:vars={{ phone: site.phoneHref, mail: site.email }}>
  const form = document.querySelector('[data-enquiry]');
  const done = document.querySelector('[data-enquiry-done]');
  const counter = document.querySelector('[data-char-count]');
  const message = document.querySelector('#message');

  message?.addEventListener('input', () => {
    if (counter) counter.textContent = String(message.value.length);
  });

  const setError = (name, msg) => {
    const input = form?.querySelector(`[name="${name}"]`);
    const slot = form?.querySelector(`[data-err-for="${name}"]`);
    if (slot) slot.textContent = msg;
    input?.classList.toggle('is-invalid', Boolean(msg));
    if (msg) input?.setAttribute('aria-invalid', 'true');
    else input?.removeAttribute('aria-invalid');
  };

  const validate = (data) => {
    let ok = true;
    const name = String(data.get('name') ?? '').trim();
    const phoneVal = String(data.get('phone') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const date = String(data.get('date') ?? '');

    setError('name', '');
    setError('phone', '');
    setError('email', '');
    setError('date', '');

    if (name.length < 2) { setError('name', 'Please enter your name.'); ok = false; }
    if (!/^[+\d][\d\s\-()]{7,17}$/.test(phoneVal)) {
      setError('phone', 'Please enter a valid phone number.');
      ok = false;
    }
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      setError('email', 'Please enter a valid email address.');
      ok = false;
    }
    if (date) {
      const today = new Date(); today.setHours(0, 0, 0, 0);
      if (new Date(date) < today) { setError('date', 'Please choose a future date.'); ok = false; }
    }
    return ok;
  };

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!validate(data)) {
      form.querySelector('.is-invalid')?.focus();
      return;
    }

    const lines = [
      'Kerala trip enquiry',
      `Name: ${data.get('name')}`,
      `Phone: ${data.get('phone')}`,
      data.get('email') ? `Email: ${data.get('email')}` : '',
      data.get('date') ? `Travel date: ${data.get('date')}` : '',
      `Travellers: ${data.get('travellers')}`,
      `Package: ${data.get('package')}`,
      data.get('message') ? `Notes: ${data.get('message')}` : '',
    ].filter(Boolean);
    const body = lines.join('\n');

    const wa = document.querySelector('[data-wa-send]');
    const em = document.querySelector('[data-mail-send]');
    if (wa) wa.href = `https://wa.me/${phone.replace('+', '')}?text=${encodeURIComponent(body)}`;
    if (em) {
      em.href = `mailto:${mail}?subject=${encodeURIComponent('Kerala Trip Enquiry')}&body=${encodeURIComponent(body)}`;
    }

    form.hidden = true;
    if (done) done.hidden = false;
    done?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  document.querySelector('[data-enquiry-reset]')?.addEventListener('click', () => {
    if (done) done.hidden = true;
    if (form) form.hidden = false;
  });

  // Pre-select a package when arriving from a package page (?package=…).
  const preset = new URLSearchParams(location.search).get('package');
  if (preset) {
    const select = form?.querySelector('#package');
    const match = Array.from(select?.options ?? []).find((o) =>
      o.value.toLowerCase().includes(preset.toLowerCase())
    );
    if (select && match) select.value = match.value;
  }
</script>
