---
import { site } from '../data/site';
const waText = encodeURIComponent(
  "Hi Make My Kerala! I'd like to plan a Kerala trip."
);
---

<div class="fab">
  <a
    class="fab__btn fab__btn--wa"
    href={`https://wa.me/${site.phoneHref.replace('+', '')}?text=${waText}`}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Chat on WhatsApp"
  >
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.17h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.4c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.83 2.41a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.25-8.24 8.25Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.44.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.44.06-.67.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.02 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.67-1.18.21-.58.21-1.08.15-1.18-.06-.11-.23-.17-.48-.29Z"/>
    </svg>
  </a>
  <a class="fab__btn fab__btn--call" href={`tel:${site.phoneHref}`} aria-label={`Call ${site.phone}`}>
    <span aria-hidden="true">☎</span>
  </a>
  <button class="fab__btn fab__btn--top" type="button" data-to-top aria-label="Back to top">
    <span aria-hidden="true">↑</span>
  </button>
</div>

<style>
  .fab {
    position: fixed; right: clamp(0.75rem, 3vw, 1.5rem); z-index: 90;
    bottom: calc(clamp(0.75rem, 3vw, 1.5rem) + env(safe-area-inset-bottom));
    display: flex; flex-direction: column; gap: 0.6rem;
  }
  .fab__btn {
    width: 50px; height: 50px; border-radius: 50%;
    display: grid; place-content: center;
    box-shadow: var(--shadow); color: var(--white);
    transition: transform 0.25s var(--ease), opacity 0.3s var(--ease), background 0.25s var(--ease);
  }
  .fab__btn:hover { transform: scale(1.08); }
  .fab__btn--wa { background: #25d366; }
  .fab__btn--call { background: var(--green-700); font-size: 1.15rem; }
  .fab__btn--top {
    background: var(--gold-500); color: var(--green-900); font-size: 1.1rem; font-weight: 700;
    opacity: 0; pointer-events: none; transform: translateY(10px);
  }
  .fab__btn--top.is-visible { opacity: 1; pointer-events: auto; transform: none; }
  @media (min-width: 900px) { .fab__btn--call { display: none; } }
</style>
