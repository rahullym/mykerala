---
interface Props {
  kicker: string;
  title: string;
  accent?: string;
  lede?: string;
  image?: string;
  crumbs?: { label: string; href?: string }[];
}
const { kicker, title, accent, lede, image = '/images/munnar.jpg', crumbs = [] } = Astro.props;
---

<section class="phero">
  <img class="phero__bg" src={image} alt="" width="1600" height="900" />
  <div class="phero__veil"></div>
  <div class="wrap phero__inner">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>
              {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
              {i < crumbs.length - 1 && <i aria-hidden="true">/</i>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    <p class="kicker phero__kicker">{kicker}</p>
    <h1>{title}{accent && <> <span class="phero__accent">{accent}</span></>}</h1>
    {lede && <p class="phero__lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative; isolation: isolate; color: var(--cream);
    padding-top: calc(var(--header-h) + clamp(3rem, 9vw, 6rem));
    padding-bottom: clamp(2.5rem, 7vw, 5rem);
    overflow: hidden;
  }
  .phero__bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .phero__veil {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(6, 40, 29, 0.82) 0%, rgba(6, 40, 29, 0.7) 55%, rgba(6, 40, 29, 0.94) 100%);
  }
  .phero__kicker { color: var(--gold-400); }
  .phero h1 { margin-top: 0.9rem; font-size: clamp(2.1rem, 6.5vw, 4rem); }
  .phero__accent { font-style: italic; color: var(--gold-400); }
  .phero__lede { margin-top: 1.1rem; max-width: 54ch; color: rgba(250, 247, 240, 0.8); font-size: clamp(0.96rem, 2.2vw, 1.1rem); }

  .crumbs { margin-bottom: 1.25rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; font-size: 0.78rem; }
  .crumbs li { display: flex; align-items: center; gap: 0.5rem; color: rgba(250, 247, 240, 0.62); }
  .crumbs a:hover { color: var(--gold-400); }
  .crumbs i { opacity: 0.4; font-style: normal; }
</style>
